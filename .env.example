# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored and never committed.

# Production domain, used for canonical URLs / hreflang / Open Graph / JSON-LD.
# Falls back to a placeholder (https://exiflens.com) until you set this.
NEXT_PUBLIC_SITE_URL=

# Google AdSense publisher ID (from your AdSense account, starts with "pub-")
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Coupang Partners Open API credentials (Coupang Partners dashboard > Open API)
# Server-only — never expose these with a NEXT_PUBLIC_ prefix.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
# The subId/tracking code attached to your Coupang Partners links
COUPANG_PARTNER_SUBID=

# VWorld (브이월드) API key — Korean airspace overlay (WMS) + FAA-style
# lookups. Get one at https://www.vworld.kr (마이포털 > 인증키 관리).
# VWORLD_API_KEY/VWORLD_DOMAIN are server-only. The NEXT_PUBLIC_ copies are
# intentionally exposed to the browser — VWorld's WMS tiles must be
# requested directly from the client (see src/components/flight-map.tsx).
VWORLD_API_KEY=
VWORLD_DOMAIN=
NEXT_PUBLIC_VWORLD_API_KEY=
NEXT_PUBLIC_VWORLD_DOMAIN=

# Google Maps Platform API key — used for Korean address search (Places API
# "Text Search", regionCode=KR) since VWorld's own address search blocks
# requests from Vercel's server IPs (see src/lib/geocode.ts). In Google
# Cloud Console: create a project, enable "Places API (New)", enable
# billing (10,000 free requests/month), then create an API key restricted
# to that API only. Server-only — never expose with a NEXT_PUBLIC_ prefix.
GOOGLE_PLACES_API_KEY=

# Unsplash API key — used to auto-attach a representative image to guide
# articles on publish (src/app/api/dev/guide-image-*, automation/attach-
# guide-image.py) and by the dev-only image management panel (guides/[slug]
# page, NODE_ENV=development only). Get a free Demo-tier key at
# https://unsplash.com/oauth/applications. Needed in TWO places:
# this .env.local (read by the dev tool API routes) AND automation/.env
# (a separate file, git-ignored, read by the publish-time Python script —
# not the same loading path as Next.js env vars).
UNSPLASH_ACCESS_KEY=
